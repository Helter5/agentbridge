{
  "name": "agentbridge",
  "version": "1.0.1",
  "description": "Universal Skill & MCP Sync Engine for AI Coding Agents (Antigravity, Claude Code, Codex, Cursor)",
  "type": "module",
  "bin": {
    "agentbridge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "antigravity",
    "claude-code",
    "codex",
    "cursor",
    "mcp",
    "model-context-protocol",
    "skills",
    "sync",
    "cli"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Helter5/agentbridge.git"
  },
  "bugs": {
    "url": "https://github.com/Helter5/agentbridge/issues"
  },
  "homepage": "https://github.com/Helter5/agentbridge#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.0.7",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
